{
  "name": "@localforge/desktop",
  "version": "0.1.0",
  "author": {
    "name": "wumanman"
  },
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "pnpm run build && electron-builder --publish never",
    "package:win": "pnpm run build && electron-builder --win nsis --publish never",
    "package:portable": "pnpm run build && electron-builder --win portable --publish never",
    "package:mac": "pnpm run build && electron-builder --mac dmg --publish never",
    "package:linux": "pnpm run build && electron-builder --linux AppImage deb --publish never",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "fix-sandbox": "chown root:root node_modules/electron/dist/chrome-sandbox && chmod 4755 node_modules/electron/dist/chrome-sandbox"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@localforge/shared": "workspace:*",
    "better-sqlite3": "12.11.1",
    "electron-store": "^10.0.0",
    "systeminformation": "^5.24.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "4.2.0",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "fast-glob": "^3.3.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.10",
    "vite-plugin-svg-icons": "^2.0.1"
  },
  "build": {
    "appId": "com.localforge.app",
    "productName": "LocalForge",
    "executableName": "localforge",
    "icon": "build/app-icon.png",
    "afterPack": "build/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/app-icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "build/tray-icon.png",
        "to": "tray-icon.png"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Hardware Overlay <maintainer@example.invalid>"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    }
  }
}
