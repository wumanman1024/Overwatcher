{
  "name": "@hardware-overlay/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "pnpm run build && electron-builder --publish never",
    "package:win": "pnpm run build && electron-builder --win nsis --publish never",
    "package:portable": "pnpm run build && electron-builder --win portable --publish never --config.win.signAndEditExecutable=false",
    "package:mac": "pnpm run build && electron-builder --mac dmg --publish never",
    "package:linux": "pnpm run build && electron-builder --linux AppImage deb --publish never",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "fix-sandbox": "chown root:root node_modules/electron/dist/chrome-sandbox && chmod 4755 node_modules/electron/dist/chrome-sandbox"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@hardware-overlay/shared": "workspace:*",
    "electron-store": "^10.0.0",
    "systeminformation": "^5.24.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.hardwareoverlay.app",
    "productName": "硬件监控",
    "executableName": "hardware-overlay",
    "icon": "build/core-pulse-icon.png",
    "afterPack": "build/after-pack.cjs",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "asar": true,
    "linux": { "target": ["AppImage", "deb"], "category": "Utility", "maintainer": "Hardware Overlay <maintainer@example.invalid>" },
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.utilities" }
  }
}
