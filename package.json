{
  "name": "hardware-overlay-workspace",
  "version": "0.1.0",
  "description": "跨平台硬件监控悬浮窗",
  "author": {
    "name": "Hardware Overlay",
    "email": "maintainer@example.invalid"
  },
  "homepage": "https://example.invalid/hardware-overlay",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --filter @hardware-overlay/desktop dev",
    "build": "pnpm --filter @hardware-overlay/shared build && pnpm --filter @hardware-overlay/desktop build",
    "preview": "pnpm --filter @hardware-overlay/desktop preview",
    "test": "pnpm --filter @hardware-overlay/shared test && pnpm --filter @hardware-overlay/desktop test",
    "package": "pnpm --filter @hardware-overlay/desktop package",
    "package:win": "pnpm --filter @hardware-overlay/desktop package:win",
    "package:portable": "pnpm --filter @hardware-overlay/desktop package:portable",
    "package:mac": "pnpm --filter @hardware-overlay/desktop package:mac",
    "package:linux": "pnpm --filter @hardware-overlay/desktop package:linux",
    "fix-sandbox": "pnpm --filter @hardware-overlay/desktop fix-sandbox"
  }
}
